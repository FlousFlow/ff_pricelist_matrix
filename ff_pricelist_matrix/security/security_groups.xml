<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 group model: res.groups carry a privilege_id pointing to
         res.groups.privilege (which holds the section category). -->
    <record model="res.groups.privilege" id="res_groups_privilege_price_matrix">
        <field name="name">Price Matrix</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>

    <record id="group_price_matrix_user" model="res.groups">
        <field name="name">Price Matrix User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_price_matrix"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Can open the Price Category Matrix board in read-only mode.</field>
    </record>

    <record id="group_price_matrix_manager" model="res.groups">
        <field name="name">Price Matrix Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_price_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_price_matrix_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can edit matrix cells, run bulk operations, import Excel files and manage product pricing exceptions.</field>
    </record>
</odoo>
